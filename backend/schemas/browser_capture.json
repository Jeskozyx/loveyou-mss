{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xoose.local/schemas/browser_capture.json",
  "title": "Xoose-LoveYou Specific Screen & Live Capture Selection Configuration",
  "description": "Skema konfigurasi runtime berversi untuk service_key 'browser_capture_service' yang mengendalikan pemilihan sumber capture secara live tanpa rebuild EXE.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "capture_policy",
    "browser_capture",
    "window_capture"
  ],
  "properties": {
    "capture_policy": {
      "type": "object",
      "description": "Kebijakan sumber capture aktif yang dapat diubah secara live dari dashboard Xoose.",
      "additionalProperties": false,
      "required": [
        "active_source",
        "allow_live_switch"
      ],
      "properties": {
        "active_source": {
          "type": "string",
          "enum": [
            "disabled",
            "browser_domain",
            "application_window",
            "desktop_mss"
          ],
          "default": "desktop_mss",
          "description": "Sumber tangkapan layar aktif saat runtime."
        },
        "allow_live_switch": {
          "type": "boolean",
          "default": true,
          "description": "Izinkan perpindahan mode capture saat aplikasi sedang berjalan tanpa rebuild."
        }
      }
    },
    "browser_capture": {
      "type": "object",
      "description": "Aturan dan kebijakan tangkapan isi tab aktif browser via WebExtensions + Native Messaging.",
      "additionalProperties": false,
      "required": [
        "enabled",
        "capture_mode",
        "permission_mode",
        "local_session_required",
        "pause_when_browser_unfocused",
        "pause_when_tab_inactive",
        "image_format",
        "fallback_format",
        "capture_interval_seconds",
        "rules"
      ],
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false,
          "description": "Status aktif capture domain browser. Wajib false secara default."
        },
        "capture_mode": {
          "type": "string",
          "enum": [
            "active_tab"
          ],
          "default": "active_tab",
          "description": "Hanya menangkap area terlihat pada tab browser aktif."
        },
        "permission_mode": {
          "type": "string",
          "enum": [
            "local_start",
            "automatic_domain"
          ],
          "default": "local_start",
          "description": "Mode izin browser: local_start (activeTab) atau automatic_domain (<all_urls> opsional)."
        },
        "local_session_required": {
          "type": "boolean",
          "default": true,
          "description": "Memastikan sesi lokal pengguna aktif dan tidak dalam status Stop lokal."
        },
        "pause_when_browser_unfocused": {
          "type": "boolean",
          "default": true,
          "description": "Menjeda capture otomatis saat jendela browser kehilangan fokus."
        },
        "pause_when_tab_inactive": {
          "type": "boolean",
          "default": true,
          "description": "Menjeda capture otomatis saat tab target tidak lagi aktif."
        },
        "image_format": {
          "type": "string",
          "enum": [
            "webp",
            "png"
          ],
          "default": "webp",
          "description": "Format gambar utama hasil capture browser."
        },
        "fallback_format": {
          "type": "string",
          "enum": [
            "png",
            "jpeg"
          ],
          "default": "png",
          "description": "Format cadangan bila konversi format utama tidak tersedia."
        },
        "capture_interval_seconds": {
          "type": "integer",
          "minimum": 2,
          "maximum": 3600,
          "default": 10,
          "description": "Interval antar capture tab aktif dalam detik."
        },
        "rules": {
          "type": "array",
          "maxItems": 50,
          "default": [],
          "description": "Daftar aturan domain browser target.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "enabled",
              "domain",
              "include_subdomains",
              "schemes",
              "browsers"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 2,
                "maxLength": 64,
                "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$",
                "description": "Identifier unik rule dalam daftar rules."
              },
              "enabled": {
                "type": "boolean",
                "default": true
              },
              "domain": {
                "type": "string",
                "minLength": 3,
                "maxLength": 253,
                "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+$",
                "description": "Nama domain valid huruf kecil tanpa skema, wildcard, port, atau path."
              },
              "include_subdomains": {
                "type": "boolean",
                "default": true,
                "description": "Jika true, mencocokkan semua subdomain (*.domain) secara ketat pada batas titik."
              },
              "schemes": {
                "type": "array",
                "minItems": 1,
                "maxItems": 2,
                "uniqueItems": true,
                "default": [
                  "https"
                ],
                "items": {
                  "type": "string",
                  "enum": [
                    "https",
                    "http"
                  ]
                }
              },
              "browsers": {
                "type": "array",
                "minItems": 1,
                "maxItems": 3,
                "uniqueItems": true,
                "default": [
                  "chrome",
                  "edge",
                  "firefox"
                ],
                "items": {
                  "type": "string",
                  "enum": [
                    "chrome",
                    "edge",
                    "firefox"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "window_capture": {
      "type": "object",
      "description": "Aturan tangkapan jendela aplikasi aktif via MSS + GetForegroundWindow (terpisah dari browser extension).",
      "additionalProperties": false,
      "required": [
        "enabled",
        "capture_mode",
        "capture_interval_seconds",
        "rules"
      ],
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "capture_mode": {
          "type": "string",
          "enum": [
            "active_window"
          ],
          "default": "active_window"
        },
        "capture_interval_seconds": {
          "type": "integer",
          "minimum": 2,
          "maximum": 3600,
          "default": 10
        },
        "rules": {
          "type": "array",
          "maxItems": 50,
          "default": [],
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "enabled",
              "process",
              "window_title_contains"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 2,
                "maxLength": 64,
                "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$"
              },
              "enabled": {
                "type": "boolean",
                "default": false
              },
              "process": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120,
                "pattern": "^[a-zA-Z0-9._-]{1,120}$",
                "description": "Nama proses Windows aman (misal chrome.exe, Code.exe) tanpa karakter path."
              },
              "window_title_contains": {
                "type": "string",
                "maxLength": 200,
                "default": "",
                "description": "Substring opsional judul jendela aktif (case-insensitive)."
              }
            }
          }
        }
      }
    }
  }
}
